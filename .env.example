# Récupère ta clé sur https://materialsproject.org/dashboard
MP_API_KEY=your_api_key_here

# Supabase (historique de sessions)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# LLM de l'agent : Groq (prioritaire s'il est défini) ou Claude
GROQ_API_KEY=
# Optionnel : défaut llama-3.3-70b-versatile
GROQ_MODEL=

# Claude API (alternative à Groq)
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé par l'agent (défaut claude-sonnet-5-5)
ANTHROPIC_MODEL=
